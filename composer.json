{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jaypalsapara/laravel-react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^3.7",
        "laravel/chisel": "^0.1.1",
        "laravel/fortify": "^1.43.0",
        "laravel/framework": "^13.43",
        "laravel/tinker": "^3.2",
        "laravel/wayfinder": "^0.1.23",
        "nunomaduro/essentials": ">=1.2"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7.3",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.15",
        "laravel/pail": "^1.3.0",
        "laravel/pao": "^1.1.6",
        "laravel/pint": "^1.32.3",
        "laravel/sail": "^1.71",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.6",
        "pestphp/pest": "^5.3.7",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^5.1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install",
            "pnpm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "pnpm run lint"
        ],
        "lint:check": [
            "pint --parallel --test",
            "rector --dry-run",
            "pnpm run lint:check"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=2G",
            "pnpm run types:check"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:unit": "pest --parallel --coverage --exactly=100.0",
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@test:type-coverage",
            "@test:unit",
            "@php artisan test"
        ],
        "update:requirements": [
            "composer bump",
            "pnpm dlx npm-check-updates -u"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@update:requirements"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
